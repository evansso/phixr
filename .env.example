# Copy to .env.local (development) or .env.production (production) and fill in your own values. Never commit real secrets.

# Clerk (auth)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Clerk webhook signing secret (set on the Convex deployment, not just .env.local)
CLERK_WEBHOOK_SECRET=

# Resend (welcome email) — set these on the Convex deployment
RESEND_API_KEY=
RESEND_WELCOME_TEMPLATE_ID=welcome-email-beta
# Optional: overrides the From address saved in the Resend template
RESEND_FROM_EMAIL=

# Polar (billing) — set these on the Convex deployment
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_BETA_PRODUCT_ID=

# Convex (database / backend)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# AI model (Meta Muse via Open Responses API)
MUSE_META_API_KEY=

# Web research (Exa)
EXA_API_KEY=

# Chat image uploads (public Upstash Blob bucket)
UPSTASH_BLOB_TOKEN=

# Voice input (Deepgram)
DEEPGRAM_API_KEY=

# Optional: AI Gateway
AI_GATEWAY_API_KEY=
